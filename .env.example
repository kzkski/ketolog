NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sentry（監視）
# NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@o<orgId>.ingest.sentry.io/<projectId>
# SENTRY_DSN=https://<publicKey>@o<orgId>.ingest.sentry.io/<projectId>
# SENTRY_AUTH_TOKEN=sntrys_<token>
# SENTRY_ORG=<org-slug>
# SENTRY_PROJECT=<project-slug>
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_APP_ENV=production
# リリース（Sentry の release）:
# - Vercel: ビルド時の VERCEL_GIT_COMMIT_SHA が next.config 経由で NEXT_PUBLIC_SENTRY_RELEASE に入る（手入力不要）
# - ローカル: 任意で SENTRY_RELEASE / NEXT_PUBLIC_SENTRY_RELEASE にコミットSHAや package 版を入れる
# SENTRY_RELEASE=ecb1194...
# NEXT_PUBLIC_SENTRY_RELEASE=ecb1194...

# Optional: ヘッダーのバージョン番号クリックで開く先（例: GitHub上のCHANGELOG.md）
# NEXT_PUBLIC_CHANGELOG_URL=https://github.com/<owner>/<repo>/blob/main/CHANGELOG.md

# Open Food Facts API（バーコード連携）。未設定時は README のデフォルト User-Agent が使われる。
# OFF 利用申告は本プロジェクトで実施済み。連絡先を変える場合は User-Agent を更新し、必要に応じ公式フォームで情報を更新すること。README「Open Food Facts API」参照。
# OFF_USER_AGENT=Ketolog/1.7.2 (you@example.com)
# OFF_API_BASE=https://world.openfoodfacts.org
