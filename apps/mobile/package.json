{
  "name": "@ketolog/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "run:ios": "expo run:ios",
    "run:ios:clean": "expo run:ios --no-build-cache",
    "run:android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:build:ios:preview": "npx --yes eas-cli build --platform ios --profile preview",
    "eas:build:ios:production": "npx --yes eas-cli build --platform ios --profile production",
    "eas:submit:ios:production": "npx --yes eas-cli submit --platform ios --profile production",
    "eas:credentials:ios": "npx --yes eas-cli credentials --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@ketolog/domain": "*",
    "@ketolog/types": "*",
    "@react-navigation/native": "^7.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.104.0",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "~5.9.2"
  },
  "private": true
}
